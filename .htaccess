# Block direct download of data and project files (results.csv, composer.*, etc.).
# auth.php still reads them from disk; only HTTP access is refused.
<FilesMatch "\.(csv|lock|json|md|yml|ini|log)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Hide PHP dependencies and dotfiles (except .well-known).
RedirectMatch 403 ^/vendor/
RedirectMatch 403 /\.(?!well-known)

# No directory listings.
Options -Indexes
